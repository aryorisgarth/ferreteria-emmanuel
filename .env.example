# =============================================================================
# FERRETERÍA EMMANUEL — Variables de Entorno de Producción y Desarrollo
# =============================================================================
# Copie este archivo a '.env.local' para desarrollo o configure estas variables
# en los Secretos de GitHub / Cloudflare / Vercel para producción.
# =============================================================================

# 1. Seguridad de Sesión y Autenticación Criptográfica (OBLIGATORIO)
# Clave simétrica de al menos 32 caracteres para firmar y verificar tokens HMAC-SHA256
AUTH_SECRET=clave_secreta_super_segura_de_al_menos_32_caracteres_ferreteria_emmanuel

# 2. Configuración de Entorno y Rendimiento
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0

# 3. Base de Datos PostgreSQL / Supabase (Opcional)
# Si se dejan en blanco, el sistema operará automáticamente en modo local (data/bodega.json)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_publica_anon_de_supabase
SUPABASE_SERVICE_ROLE_KEY=tu_clave_privada_service_role_de_supabase
