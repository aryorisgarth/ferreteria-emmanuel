# =============================================================================
# FERRETERÍA EMMANUEL — VARIABLES DE ENTORNO PARA PRODUCCIÓN (VERCEL + NEON)
# =============================================================================
# Configure estas variables en el panel de Vercel (Project Settings -> Environment Variables)
# =============================================================================

# 1. MODO DE PERSISTENCIA EXCLUSIVO PARA PRODUCCIÓN (POSTGRESQL / NEON)
STORAGE_PROVIDER=postgres

# 2. CONEXIÓN A NEON POSTGRESQL (Base de datos de producción limpia)
# DATABASE_URL: Conexión directa (utilizada para migraciones y transacciones de alta consistencia)
DATABASE_URL=postgres://usuario:password@ep-ejemplo.us-east-1.aws.neon.tech/neondb?sslmode=require

# DATABASE_URL_POOLED: Conexión con pooling (PgBouncer de Neon para Serverless en Vercel)
DATABASE_URL_POOLED=postgres://usuario:password@ep-ejemplo-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# 3. SEGURIDAD DE SESIÓN (OBLIGATORIO)
# Clave criptográfica única de 32+ caracteres para tokens HMAC-SHA256
AUTH_SECRET=genera_aqui_una_clave_criptografica_aleatoria_de_al_menos_32_caracteres_emmanuel

# 4. CONFIGURACIÓN DEL ENTORNO NEXT.JS
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
